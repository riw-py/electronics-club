# Server
PORT=5000
NODE_ENV=development

# Database - SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_DATABASE=electronics_club
# Windows Authentication (leave blank for local dev with your Windows login)
DB_USER=
DB_PASSWORD=
# SQL Server Authentication (fill in if using SQL login)
# DB_USER=sa
# DB_PASSWORD=YourPassword123!

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# LINE Notify (Phase 2)
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=../uploads
